{{- if and (eq .chezmoi.os "darwin") (eq .purpose "bol") -}}
#!/bin/bash
# Installs the Gruvbox theme plugin ("Gruvbox Islands - Theme", marketplace id 34175) into IntelliJ IDEA with the IDE's
# own CLI. Needs IntelliJ 2025.3+ and the IDE CLOSED (installPlugins edits the plugin dir). Best-effort: never fails apply.
# After the first install, pick the theme once: Settings > Appearance & Behavior > Appearance > Theme, tick "Sync with OS"
# and choose "Gruvbox Islands Dark Medium" / "Gruvbox Islands Light Medium" (Hard / Soft variants exist too).
# The plugin id below is the PLUGIN XML ID; change it here to re-run this script.
PLUGIN_ID="com.github.lonre.gruvbox-islands-theme"

# Toolbox puts its launcher scripts here (also on PATH via zsh/conf.d/61-jetbrains.zsh)
IDEA="$HOME/Library/Application Support/JetBrains/Toolbox/scripts/idea"
if [ ! -x "$IDEA" ]; then
  echo "==> IntelliJ launcher not found ($IDEA), skipping Gruvbox theme plugin."
  echo "    Generate it in JetBrains Toolbox (Settings > Tools > Shell scripts), then bump a comment in this script to re-run it"
  exit 0
fi

if pgrep -qx idea; then
  echo "==> IntelliJ is running, skipping the Gruvbox theme plugin. Install it by hand instead:"
  echo "    Settings > Plugins > Marketplace > \"Gruvbox Islands - Theme\" (or quit IntelliJ and bump PLUGIN_ID in this script to re-run it)"
  exit 0
fi

echo "==> Installing IntelliJ plugin $PLUGIN_ID"
"$IDEA" installPlugins "$PLUGIN_ID" || echo "==> WARNING: plugin install failed (install it by hand from the Marketplace, id 34175); not failing apply" >&2
exit 0
{{- end }}
