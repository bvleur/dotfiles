#!/bin/bash
# Itsycal preferences
set -eu

defaults write com.mowglii.ItsycalApp MenuBarIconType  -int 0   # icon type: calendar icon
defaults write com.mowglii.ItsycalApp ShowWeeks        -int 1   # show week numbers
defaults write com.mowglii.ItsycalApp ShowEventDays    -int 7   # show events 7 days ahead
defaults write com.mowglii.ItsycalApp MoCalendarNumRows -int 10 # calendar popup rows
defaults write com.mowglii.ItsycalApp HighlightedDOWs  -int 0   # no highlighted days
