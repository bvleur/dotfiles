#!/bin/bash
# Installs the yazi plugins listed in ~/.config/yazi/package.toml (`ya pkg install`).
# package.toml hash: {{ include "private_dot_config/yazi/package.toml" | sha256sum }}
set -eu

eval "$(/opt/homebrew/bin/brew shellenv)"

if ! command -v ya >/dev/null 2>&1; then
  echo "==> yazi (ya) not installed, skipping plugin install"
  exit 0
fi

echo "==> Installing yazi plugins"
ya pkg install
