#!/bin/bash
# Snapzy global shortcuts. Snapzy stores each shortcut as a Data value holding
# JSON like {"keyCode":29,"modifiers":768} (modifiers are Cocoa flags:
# cmd=256, shift=512, option=2048, ctrl=4096; keyCode is the virtual key code).
# Only the shortcuts listed here are managed; every other Snapzy preference
# is left alone. Snapzy only reads these at launch, so it is restarted if running.
set -eu

# Resolve the bundle id from the installed app; skip quietly if Snapzy is not installed (yet).
bundle_id=$(osascript -e 'id of app "Snapzy"' 2>/dev/null) || { echo "Snapzy not installed, skipping shortcuts"; exit 0; }

snapzy_shortcut() { # <defaults key> <keyCode> <modifiers>
  defaults write "$bundle_id" "$1" -data "$(printf '{"keyCode":%s,"modifiers":%s}' "$2" "$3" | xxd -p | tr -d '\n')"
}

snapzy_shortcut historyShortcut 29 768  # cmd+shift+0

# The restart is best-effort: the shortcuts are already written above, so a
# failed relaunch must never fail (or abort) chezmoi apply. Worst case the new
# shortcuts load the next time Snapzy is started.
if pgrep -x Snapzy >/dev/null 2>&1; then
  echo "==> Restarting Snapzy to load shortcut changes..."
  # pkill instead of an AppleScript quit: no Automation permission prompt
  pkill -x Snapzy || true
  for _ in $(seq 1 20); do
    pgrep -x Snapzy >/dev/null 2>&1 || break
    sleep 0.5
  done
  # The process can be gone before LaunchServices has finished tearing it down;
  # an immediate `open` then fails with error -600 (procNotFound). Pause briefly
  # and retry a few times.
  sleep 1
  reopened=false
  for _ in 1 2 3 4 5; do
    if open -a Snapzy >/dev/null 2>&1; then
      reopened=true
      break
    fi
    sleep 1
  done
  if [ "$reopened" = false ]; then
    echo "warning: could not relaunch Snapzy; start it manually to load the new shortcuts" >&2
  fi
fi
exit 0
