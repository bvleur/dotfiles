{{- /* Asked once by `chezmoi init`; the answers are kept in ~/.config/chezmoi/chezmoi.toml.
       A new question is asked by the next plain `chezmoi init`; re-ask all with `chezmoi init --prompt`. */ -}}
{{- $purpose := promptChoiceOnce . "purpose" "What type of machine is this" (list "home" "bol") -}}
{{- /* `server` layers server / remote-build extras (Xcode tooling, tmux, ...) on top of the home profile. */ -}}
{{- $server := false -}}
{{- if eq $purpose "home" -}}
{{-   $server = promptBoolOnce . "server" "Is this also a server / remote build machine" -}}
{{- end -}}
{{- /* `vpn` installs the WireGuard app; `vpn-config` (zsh) writes the client config from 1Password on demand.
       Not asked on the server: that machine is already at home. */ -}}
{{- $vpn := false -}}
{{- if not $server -}}
{{-   $vpn = promptBoolOnce . "vpn" "Set up the home WireGuard VPN client (needs a signed-in 1Password CLI)" false -}}
{{- end -}}

[data]
    purpose = {{ $purpose | quote }}
    server = {{ $server }}
    vpn = {{ $vpn }}
