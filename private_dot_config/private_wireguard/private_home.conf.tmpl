{{- /* WireGuard client config for the home network (UniFi VPN server). Nothing secret lives in this repo:
       every value is read from 1Password at `chezmoi apply`. One UniFi client, and one 1Password item, per machine:
         op://Private/WireGuard home <purpose>   i.e. "WireGuard home bol" or "WireGuard home home"
       (no brackets or other punctuation in the item name: 1Password secret references do not allow them)
       with text fields copied from the .conf that UniFi generates for that client:
         private key        [Interface] PrivateKey
         address            [Interface] Address
         server public key  [Peer] PublicKey
         endpoint           [Peer] Endpoint (host:port)
         allowed ips        the home subnet(s), e.g. 192.168.1.0/24 (split tunnel: only home traffic uses the VPN;
                            do not copy UniFi's 0.0.0.0/0 unless everything should go through home)
       The WireGuard app keeps its own copy: after this file changes, re-import it
       (WireGuard > Import Tunnel(s) from File...). */ -}}
{{- $item := printf "op://Private/WireGuard home %s" .purpose -}}
# Managed by chezmoi; secrets come from 1Password. Do not edit here.
[Interface]
PrivateKey = {{ onepasswordRead (printf "%s/private key" $item) | trim }}
Address = {{ onepasswordRead (printf "%s/address" $item) | trim }}

[Peer]
PublicKey = {{ onepasswordRead (printf "%s/server public key" $item) | trim }}
Endpoint = {{ onepasswordRead (printf "%s/endpoint" $item) | trim }}
AllowedIPs = {{ onepasswordRead (printf "%s/allowed ips" $item) | trim }}
PersistentKeepalive = 25
