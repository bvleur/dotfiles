{{- /* WireGuard client config for the home network (UniFi VPN server). Nothing secret lives in this repo:
       every value is read from 1Password at `chezmoi apply`, from one item: op://Private/WireGuard Rozemarijn
       (no brackets or other punctuation in names: 1Password secret references do not allow them).
       Each machine is its own UniFi client with its own keys, so the item has
         shared fields (no section):
           server public key  [Peer] PublicKey
           endpoint           [Peer] Endpoint (host:port)
           allowed ips        the home subnet(s), e.g. 192.168.1.0/24 (split tunnel: only home traffic uses the VPN;
                              do not copy UniFi's 0.0.0.0/0 unless everything should go through home)
         and one section per machine, named after its `purpose` ("bol", "home"):
           private key        [Interface] PrivateKey
           address            [Interface] Address
           preshared key      [Peer] PresharedKey (tick "Pre-shared key" for the client in UniFi)
       Fill the item with `wg-to-1password [-m machine] <file.conf> [home-subnet]` (30-functions.zsh), not by hand.
       The WireGuard app keeps its own copy: after this file changes, re-import it
       (WireGuard > Import Tunnel(s) from File...). */ -}}
{{- $item := "op://Private/WireGuard Rozemarijn" -}}
{{- $machine := printf "%s/%s" $item .purpose -}}
# Managed by chezmoi; secrets come from 1Password. Do not edit here.
[Interface]
PrivateKey = {{ onepasswordRead (printf "%s/private key" $machine) | trim }}
Address = {{ onepasswordRead (printf "%s/address" $machine) | trim }}

[Peer]
PublicKey = {{ onepasswordRead (printf "%s/server public key" $item) | trim }}
PresharedKey = {{ onepasswordRead (printf "%s/preshared key" $machine) | trim }}
Endpoint = {{ onepasswordRead (printf "%s/endpoint" $item) | trim }}
AllowedIPs = {{ onepasswordRead (printf "%s/allowed ips" $item) | trim }}
PersistentKeepalive = 25
