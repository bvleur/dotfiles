# Brewfile — managed by chezmoi, installed automatically on a new machine at `chezmoi apply`.
# Editing this file and running apply re-runs `brew bundle` automatically (via the run_onchange script).
# Note: no --cleanup, add-only, packages you uninstalled by hand won't be reinstalled here.

# === Shell tools ===
brew "antidote"
brew "pure"

# === CLI tools ===
brew "bat"           # cat replacement (syntax highlight)
brew "btop"          # resource monitor
brew "yazi"          # cli file manager
brew "chezmoi"       # dotfiles management (self-bootstrap)
brew "fzf"           # fuzzy finder
brew "httpie"        # HTTP client
brew "mas"           # Mac App Store CLI (used by the mas entries below)
brew "mise"          # dev-tool version manager (owns node/java/python/...)
brew "neovim"        # editor
brew "usage"         # needed by `mise completion zsh` (task names + descriptions on <Tab>)
brew "tlrc"          # tldr client
brew "viddy"         # modern watch replacement (aliased to `watch`)
brew "yazi"          # terminal file manager (`y`), config: ~/.config/yazi
brew "glow"          # markdown renderer, used for .md previews in yazi
brew "doxx"          # .docx viewer, used by the doxx yazi plugin
brew "hexyl"         # hex viewer, used by `v` for binary files
brew "jless"         # JSON viewer, used by `v` for .json
brew "csvlens"       # interactive CSV viewer, used by `v` for .csv/.tsv
brew "zoxide"        # smart cd
brew "timescam/tap/pay-respects"  # offline command fixer (`f`), thefuck successor; third-party tap, trusted by run_onchange_before_darwin-brew-trust.sh
cask "1password-cli"

# === Modern CLI replacements ===
brew "ripgrep"       # grep replacement (rg); nvim/fzf search backend
brew "bfs"           # find replacement that searches breadth-first (used by cdn: shallowest match first)
brew "fd"            # find replacement; fzf/nvim find-files backend (respects .gitignore)
brew "eza"           # ls replacement (icons / git status)

# === Git ===
brew "gh"            # GitHub CLI
brew "lazygit"       # git TUI (invoked directly by LazyVim <leader>gg)

# === Zsh prompt and plugins ===
#brew "powerlevel10k"     # prompt (fastest per zsh-bench, instant prompt)
#brew "zsh-autosuggestions"
#brew "zsh-completions"
#brew "zsh-syntax-highlighting"

# === GUI apps ===
cask "homebrew-app"
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"   # the one coding font everywhere (Ghostty, Zed); the Nerd Font build keeps eza/yazi/lazygit icons working. IntelliJ ships plain JetBrains Mono
cask "zen"             # Zen browser (Firefox-based), the default browser
cask "google-chrome"   # stable Chrome, only as a test browser (never default, see chrome-defaults script)
cask "zed"
cask "iina"
cask "monitorcontrol"
cask "linearmouse"
cask "itsycal"
cask "snapzy"
cask "vicinae"
cask "rectangle"       # only next/previous display shortcuts, config: .chezmoitemplates/RectangleConfig.json
cask "ticktick"
cask "chatgpt"

